# torch-indexer environment.
#
# Copy to .env and fill in. The .env is loaded by both docker-compose.yml
# (for Postgres bootstrap) and the indexer binary itself (via dotenvy at
# main.rs startup).

# ─────────── Postgres ────────────────────────────────────────────────
# Superuser creds. Used by docker-compose for first-boot init only —
# the indexer connects as the least-privilege `torch_indexer` role.
POSTGRES_USER=torch
POSTGRES_PASSWORD=changeme_in_real_deploys
POSTGRES_DB=torch
# Password for the limited indexer role. Created by db/02-indexer-role.sh
# on first Postgres boot.
INDEXER_DB_PASSWORD=changeme_too

# Used by the indexer binary when running on the host (cargo run from
# ./indexer). Docker-compose overrides this for the in-network indexer to
# point at postgres:5432 with the indexer role.
DATABASE_URL=postgres://torch_indexer:changeme_too@127.0.0.1:5432/torch

# ─────────── Yellowstone gRPC (live ingest) ──────────────────────────
# Helius Laserstream endpoint + API token. Required for `run` subcommand.
LASERSTREAM_URL=https://laserstream-devnet.helius-rpc.com
LASERSTREAM_TOKEN=

# ─────────── Programs ────────────────────────────────────────────────
# torch_market program id (declared in programs/torch_market/src/lib.rs).
TORCH_PROGRAM_ID=FghCwWojts9MbU3Pmog5peacaKrEYM5n1T68KWHy7TAh
# deep_pool program id (declared in ~/Projects/deep_pool/programs/deep_pool/src/lib.rs).
DEEP_POOL_PROGRAM_ID=CcwF61GW14AcxCS4E2zedHXdFXy8x8GQPvfxZrs2x2eT

# ─────────── RPC (backfill subcommand only) ──────────────────────────
# Solana JSON-RPC endpoint. getSignaturesForAddress + getTransaction live
# here. Distinct from Laserstream (gRPC). Use Helius/Triton/etc for any
# real workload — public devnet is rate-limited at ~10 RPS.
RPC_URL=https://api.devnet.solana.com

# Throttle between getTransaction calls during backfill. Default 100ms.
# Drop to ~10ms with a paid RPC.
BACKFILL_TX_THROTTLE_MS=100

# Optional cutoff: skip any signature whose slot < START_SLOT during
# backfill. Useful for fresh devnet envs that don't need stale history.
# START_SLOT=

# ─────────── Indexer runtime ─────────────────────────────────────────
API_BIND=127.0.0.1:8080

# On restart, resume gRPC subscription from
# (last_processed_slot - REORG_BUFFER_SLOTS) to survive minor reorgs.
# Idempotent UPSERTs de-dupe the replay.
REORG_BUFFER_SLOTS=32

# Tracing filter. `info` for the indexer, `warn` for sqlx (drops chatty
# query-plan logs), `info` for tower-http (HTTP access log).
RUST_LOG=torch_indexer=info,sqlx=warn,tower_http=info
